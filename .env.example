# ==============================================================================
# ScholarPath Backend Environment Variables (.env.example)
# Note: Copy this file to .env for local development. Never commit real secrets.
# ==============================================================================

# Server Configuration
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# CORS Configuration (comma-separated origins or single origin; no wildcards in production)
CORS_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL 16)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scholarpath_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Authentication Mode: 'demo' (local development) or 'production' (Firebase Admin)
AUTH_MODE=demo

# Firebase Admin Configuration (Required only when AUTH_MODE=production)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Optional AI Configuration (Optional: backend boots and operates without this key)
GEMINI_API_KEY=
