{
  "name": "scholarpath-root",
  "version": "1.0.0",
  "private": true,
  "description": "ScholarPath — From Eligibility to Action",
  "workspaces": [
    "backend",
    "frontend",
    "engine",
    "ai"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "npm --workspace=engine run build && npm --workspace=ai run build && npm --workspace=backend run build",
    "dev": "npm --workspace=backend run dev",
    "lint": "npm --workspace=backend run lint",
    "typecheck": "npm --workspace=engine run build && npm --workspace=ai run build && npm --workspace=backend run typecheck",
    "type-check": "npm run typecheck",
    "test": "vitest run && npm --workspace=backend run test",
    "test:watch": "vitest",
    "db:seed": "npm --workspace=backend run db:seed",
    "seed:schemes": "npm --workspace=backend run seed:schemes",
    "seed:schemes:dry": "npm --workspace=backend run seed:schemes:dry",
    "data:check": "npm --workspace=backend run data:check"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^1.4.0",
    "zod": "^3.22.4"
  },
  "author": "ScholarPath Team",
  "license": "UNLICENSED"
}
